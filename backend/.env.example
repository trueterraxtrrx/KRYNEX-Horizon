HORIZON_ENVIRONMENT=development
HORIZON_DEBUG=false
HORIZON_DEMO_MODE=true
HORIZON_DATABASE_URL=sqlite:///./horizon.db
HORIZON_REQUIRE_API_KEY=true
HORIZON_SERVICE_API_KEY_SHA256=
HORIZON_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional connectors - Horizon works fully without any of these set.
HORIZON_SHODAN_API_KEY=
HORIZON_NMAP_ENABLED=true
HORIZON_NMAP_BINARY_PATH=nmap
